{
  "name": "gatedelay-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start:express": "node server.js",
    "start:express:dev": "node --watch server.js",
    "start:nest": "nest start",
    "start:nest:dev": "nest start --watch",
    "start:nest:debug": "nest start --debug --watch",
    "start:nest:prod": "node dist/main",
    "build": "nest build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^5.6.1",
    "mongoose": "^8.13.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "web3": "^4.16.0"
  }
}
